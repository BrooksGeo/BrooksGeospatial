---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import DataGlobe from "../components/DataGlobe.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import { projects } from "../data/projects.mjs";
import { site } from "../data/site.mjs";
const services = [
  {
    number: "01",
    icon: "map",
    title: "GIS & mapping",
    description:
      "Turn location data into clear maps and practical insights. From parcel mapping to market-area analysis.",
    href: "/gis-mapping",
    tags: "SPATIAL ANALYSIS / CARTOGRAPHY",
  },
  {
    number: "02",
    icon: "drone",
    title: "Aerial imagery",
    description: "Show the full picture with professional drone photography, video, and commercial media.",
    href: "/commercial-drone-media",
    tags: "DRONE PHOTOGRAPHY / VIDEO",
  },
  {
    number: "03",
    icon: "layers",
    title: "Site documentation",
    description:
      "See your site from above. Document properties, infrastructure, and construction as they evolve.",
    href: "/services#site-documentation",
    tags: "PROPERTY / INFRASTRUCTURE",
  },
];
---

<Layout title="Brooks Geospatial | GIS, Aerial Imagery & Spatial Insight" description={site.description}>
  <Navbar />
  <main id="main-content">
    <section class="home-hero">
      <div class="container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow"><span class="accent-dot"></span>A different perspective</p>
          <h1>See the<br />bigger <span class="serif-word">picture.</span></h1>
          <p class="hero-description">
            On the ground. From the air. In the data.<br />We bring your world into focus with GIS mapping,
            aerial imagery, and spatial insight.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href="/services"
              >Explore our services <Icon name="northeast" size={18} /></a
            ><a class="text-link" href="/portfolio">View our work <Icon name="arrow" size={18} /></a>
          </div>
          <div class="hero-footnote">
            <span class="small-cross">✳</span><span
              >Rooted in Texas.<br /><strong>Built around your perspective.</strong></span
            >
          </div>
        </div>
        <DataGlobe />
      </div>
      <div class="container hero-baseline">
        <span>GIS. IMAGERY. INSIGHT.</span><a href="#services">Discover what’s possible <span>↓</span></a
        ><span>EST. IN TEXAS <span class="small-cross">✳</span></span>
      </div>
    </section>
    <section class="credentials-strip" aria-label="Capabilities">
      <div class="container credentials-inner">
        <span><Icon name="drone" size={21} />FAA Part 107 certified</span><span
          ><Icon name="map" size={21} />GIS & spatial analysis</span
        ><span><Icon name="pin" size={21} />Fayette County & Central Texas</span><span
          ><Icon name="layers" size={21} />From capture to clarity</span
        >
      </div>
    </section>
    <section class="section services-section" id="services">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="section-number">01 /</span> What we do</p><h2>
              A wider view.<br />A sharper understanding.
            </h2>
          </div><p>
            Good decisions start with a clear picture.<br />We connect the landscape, the imagery, and the
            data to help you see what matters.
          </p>
        </div>
        <div class="service-grid">
          {
            services.map((service) => (
              <a href={service.href} class="service-card">
                <>
                  <div class="service-card-top">
                    <>
                      <Icon name={service.icon} size={34} />
                      <span>{service.number}</span>
                    </>
                  </div>
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                  <div class="service-card-bottom">
                    <>
                      <span>{service.tags}</span>
                      <Icon name="northeast" size={21} />
                    </>
                  </div>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>
    <section class="property-home-section section">
      <div class="container property-home-grid">
        <div class="property-home-copy">
          <p class="eyebrow"><span class="accent-dot"></span>Property intelligence</p>
          <h2>One property.<br />A clearer picture.</h2>
          <p>Parcel records, aerial imagery, flood mapping, spatial analysis, and public-data research brought together in one professional report.</p>
          <a class="button button-dark" href="/property-intelligence">Explore Property Intelligence <Icon name="northeast" size={18} /></a>
        </div>
        <a class="property-home-preview" href="/property-intelligence" aria-label="Explore Property Intelligence Reports">
          <img src="/images/property-intelligence/property-report-cover.png" alt="Cover page of the sample Property Intelligence Report" width="1800" height="1390" loading="lazy" />
          <span>Property Intelligence Report <Icon name="northeast" size={16} /></span>
        </a>
      </div>
    </section>
    <section class="section selected-work" id="work">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="section-number">02 /</span> Selected work</p><h2>
              Real places.<br />Fresh perspectives.
            </h2>
          </div><a class="text-link" href="/portfolio"
            >Explore the portfolio <Icon name="northeast" size={18} /></a
          >
        </div>
        <div class="work-grid">
          {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>
      </div>
    </section>
    <section class="about-preview section">
      <div class="container about-preview-grid">
        <div class="about-landscape">
          <img
            src="/images/work/aerial-land.webp"
            alt="Aerial view of the Central Texas landscape, fields, trees, and a pond"
            width="1800"
            height="1200"
            loading="lazy"
          /><span class="photo-note"><span class="accent-dot"></span>A perspective close to home.</span>
        </div>
        <div class="about-preview-copy">
          <p class="eyebrow"><span class="section-number">03 /</span> The people behind the perspective</p><h2
          >
            Local roots.<br />A geospatial mindset.
          </h2><p>
            Brooks Geospatial is led by Davis “Mac” Brooks, a GIS analyst and FAA Part 107–certified drone
            pilot with a background in geography, market research, and hands-on fieldwork.
          </p><p>
            From Fayette County to projects across Central Texas, we pair local understanding with the tools
            to see a place differently.
          </p><a class="text-link" href="/about"
            >Meet Mac & Brooks Geospatial <Icon name="northeast" size={18} /></a
          >
        </div>
      </div>
    </section>
    <section class="process-section section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="section-number">04 /</span> How we work</p><h2>
              From your question<br />to a clearer answer.
            </h2>
          </div><p>A straightforward process.<br />Work shaped around what you need to see.</p>
        </div>
        <div class="process-grid">
          <div>
            <span>01</span><h3>Start with the purpose.</h3><p>
              We talk through your site, goals, and how you’ll use the finished maps or imagery.
            </p>
          </div><div>
            <span>02</span><h3>Capture & connect.</h3><p>
              We bring together the right imagery, location data, and analysis for your project.
            </p>
          </div><div>
            <span>03</span><h3>Make it useful.</h3><p>
              You get clear, practical deliverables ready to inform decisions or tell your story.
            </p>
          </div>
        </div>
      </div>
    </section>
    <ProjectCTA />
  </main>
  <Footer />
</Layout>
