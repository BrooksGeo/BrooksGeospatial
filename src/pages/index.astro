---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Brooks Geospatial | GIS, Drone Mapping & Aerial Site Intelligence">
    
    <Navbar />

    <section class="relative min-h-screen flex items-center overflow-hidden bg-slate-950">
        <div class="absolute inset-0 z-0">
            <video 
                class="w-full h-full object-cover opacity-50" 
                autoplay muted loop playsinline
                poster="/HSLOA_02_Aerial_RiverBend_Bluffs.jpg"
            >
                <source src="/RediRealEstateEdit.mp4" type="video/mp4">
                <source src="/hero-background.webm" type="video/webm">
            </video>
            <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/75 to-slate-950/20"></div>
            <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-slate-950 to-transparent"></div>
        </div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-28 pb-20">
            <div class="max-w-3xl">
                <p class="inline-flex items-center border border-teal-400/30 bg-teal-400/10 px-4 py-2 rounded-full text-teal-200 text-xs font-bold uppercase tracking-wider mb-6">
                    FAA Part 107 UAS Operations | GIS Mapping | Aerial Site Intelligence
                </p>
                <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6 text-white tracking-tight">
                    Geospatial work that turns field conditions into clear decisions.
                </h1>
                <p class="text-xl text-slate-200 mb-9 max-w-2xl leading-relaxed">
                    Brooks Geospatial provides drone imagery, property visuals, mapping products, and spatial analysis for real estate, development, utilities, and field operations.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/portfolio" class="bg-teal-500 text-white px-8 py-4 rounded font-bold hover:bg-teal-400 transition shadow-lg shadow-teal-900/20 text-center">
                        View Portfolio
                    </a>
                    <a href="/contact" class="bg-slate-950/40 backdrop-blur-sm border border-white/20 text-white px-8 py-4 rounded font-bold hover:bg-slate-900 hover:border-teal-400 transition text-center">
                        Discuss a Project
                    </a>
                </div>
            </div>

            <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-px max-w-4xl bg-white/10 border border-white/10">
                <div class="bg-slate-950/75 backdrop-blur-sm p-5">
                    <p class="text-2xl font-bold text-white">Part 107</p>
                    <p class="text-sm text-slate-400">Certified pilot</p>
                </div>
                <div class="bg-slate-950/75 backdrop-blur-sm p-5">
                    <p class="text-2xl font-bold text-white">GIS</p>
                    <p class="text-sm text-slate-400">Maps and analysis</p>
                </div>
                <div class="bg-slate-950/75 backdrop-blur-sm p-5">
                    <p class="text-2xl font-bold text-white">Aerial</p>
                    <p class="text-sm text-slate-400">Photo and video</p>
                </div>
                <div class="bg-slate-950/75 backdrop-blur-sm p-5">
                    <p class="text-2xl font-bold text-white">Texas</p>
                    <p class="text-sm text-slate-400">Central Texas focus</p>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-24 bg-slate-950 relative">
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-14 max-w-3xl">
                <p class="text-teal-400 text-sm font-bold uppercase tracking-wider mb-3">Services</p>
                <h2 class="text-3xl md:text-5xl font-bold text-white mb-5">Professional deliverables for site, property, and infrastructure decisions.</h2>
                <p class="text-slate-400 text-lg leading-relaxed">
                    The focus is practical: clean visuals, accurate spatial context, and deliverables a manager, client, or field crew can act on.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6">
                <article class="group bg-slate-900 rounded-lg overflow-hidden border border-slate-800 hover:border-teal-500/50 transition duration-300">
                    <div class="h-56 overflow-hidden relative">
                        <img src="/service-gis.jpg" alt="GIS map production and spatial analysis" class="w-full h-full object-cover transition duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent opacity-80"></div>
                    </div>
                    <div class="p-7">
                        <h3 class="text-xl font-bold mb-3 text-white">GIS Mapping & Analysis</h3>
                        <p class="text-slate-400 leading-relaxed mb-5">
                            Map production, geocoding, spatial data cleanup, site context, and decision-ready exhibits.
                        </p>
                        <p class="text-sm text-teal-300 font-semibold">ArcGIS | Spatial data | Market context</p>
                    </div>
                </article>

                <article class="group bg-slate-900 rounded-lg overflow-hidden border border-slate-800 hover:border-teal-500/50 transition duration-300">
                    <div class="h-56 overflow-hidden relative">
                        <img src="/HSLOA_02_Aerial_RiverBend_Bluffs.jpg" alt="Aerial river bend site documentation" class="w-full h-full object-cover transition duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent opacity-80"></div>
                    </div>
                    <div class="p-7">
                        <h3 class="text-xl font-bold mb-3 text-white">Aerial Site Documentation</h3>
                        <p class="text-slate-400 leading-relaxed mb-5">
                            High-resolution photo and video for real estate, development, inspection, and progress reporting.
                        </p>
                        <p class="text-sm text-teal-300 font-semibold">Drone photo | Video | Progress views</p>
                    </div>
                </article>

                <article class="group bg-slate-900 rounded-lg overflow-hidden border border-slate-800 hover:border-teal-500/50 transition duration-300">
                    <div class="h-56 overflow-hidden relative">
                        <img src="/02_Aerial_PropertyOverview_Boundary.jpg" alt="Aerial property boundary overview" class="w-full h-full object-cover transition duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent opacity-80"></div>
                    </div>
                    <div class="p-7">
                        <h3 class="text-xl font-bold mb-3 text-white">Property & Utility Support</h3>
                        <p class="text-slate-400 leading-relaxed mb-5">
                            Boundary visuals, asset context, vegetation observations, and site exhibits for stakeholder review.
                        </p>
                        <p class="text-sm text-teal-300 font-semibold">Property visuals | Asset context | Reports</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="py-24 bg-slate-900 border-y border-slate-800">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-center">
                <div>
                    <p class="text-teal-400 text-sm font-bold uppercase tracking-wider mb-3">Featured Work</p>
                    <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Aerial imagery with business context.</h2>
                    <p class="text-slate-300 text-lg leading-relaxed mb-8">
                        Current project media highlights the type of polished field documentation Brooks Geospatial can deliver: cinematic overview video, property boundary visuals, and broad site context for planning or marketing.
                    </p>
                    <div class="grid sm:grid-cols-2 gap-4 text-sm text-slate-300">
                        <div class="border border-white/10 rounded-lg p-4 bg-slate-950/40">
                            <p class="font-bold text-white mb-1">Use cases</p>
                            <p>Real estate marketing, site review, stakeholder updates, project documentation.</p>
                        </div>
                        <div class="border border-white/10 rounded-lg p-4 bg-slate-950/40">
                            <p class="font-bold text-white mb-1">Deliverables</p>
                            <p>Edited video, high-resolution imagery, boundary exhibits, GIS-ready visuals.</p>
                        </div>
                    </div>
                </div>
                <div class="border border-white/10 rounded-lg overflow-hidden bg-slate-950 shadow-2xl">
                    <video class="w-full aspect-video object-cover" controls playsinline poster="/HSLOA_02_Aerial_RiverBend_Bluffs.jpg">
                        <source src="/RediRealEstateEdit.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-slate-950">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-3 gap-10 items-start">
                <div>
                    <p class="text-teal-400 text-sm font-bold uppercase tracking-wider mb-3">Process</p>
                    <h2 class="text-3xl font-bold text-white mb-5">Straightforward from field capture to final file.</h2>
                    <p class="text-slate-400 leading-relaxed">
                        Each project is scoped around what the audience needs to understand: location, conditions, assets, boundaries, progress, or opportunity.
                    </p>
                </div>
                <div class="lg:col-span-2 grid md:grid-cols-3 gap-4">
                    <div class="border border-slate-800 rounded-lg p-6 bg-slate-900">
                        <p class="text-teal-300 font-bold mb-3">01. Scope</p>
                        <h3 class="text-white font-bold mb-2">Define the decision</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">Clarify site, deliverables, schedule, and what the final audience needs to see.</p>
                    </div>
                    <div class="border border-slate-800 rounded-lg p-6 bg-slate-900">
                        <p class="text-teal-300 font-bold mb-3">02. Capture</p>
                        <h3 class="text-white font-bold mb-2">Collect clean data</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">Use UAS imagery and GIS sources to document the location with useful context.</p>
                    </div>
                    <div class="border border-slate-800 rounded-lg p-6 bg-slate-900">
                        <p class="text-teal-300 font-bold mb-3">03. Deliver</p>
                        <h3 class="text-white font-bold mb-2">Package for action</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">Provide visuals, maps, video, or exhibits that are ready for review and presentation.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="py-24 bg-slate-900 border-t border-slate-800">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <p class="text-teal-400 text-sm font-bold uppercase tracking-wider mb-3">Contact</p>
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">Need a site documented, mapped, or presented clearly?</h2>
            <p class="text-slate-400 mb-10 text-lg leading-relaxed max-w-2xl mx-auto">
                Send a short note with the location, timeline, and intended deliverable. Brooks Geospatial will respond with practical next steps.
            </p>
            
            <a href="mailto:mac@brooksgeospatial.com" class="inline-flex items-center justify-center bg-teal-500 text-white px-8 py-4 rounded font-bold hover:bg-teal-400 transition shadow-lg shadow-teal-900/20">
                mac@brooksgeospatial.com
            </a>
        </div>
    </section>

    <footer class="py-12 bg-slate-950 border-t border-slate-800 text-center">
        <div class="flex justify-center mb-4">
             <img src="/logo2.png" alt="Brooks Geospatial" class="h-8 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition duration-500" />
        </div>
        <p class="text-slate-600 text-sm">&copy; 2026 Brooks Geospatial. All rights reserved.</p>
    </footer>

</Layout>
