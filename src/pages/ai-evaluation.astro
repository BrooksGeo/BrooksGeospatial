---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";

const deliverables = [
  "Task library",
  "Inputs",
  "Reference outputs",
  "Scoring rubric",
  "Automated checks where appropriate",
  "Failure report",
  "Executive summary",
  "Regression pack",
];
const practices = [
  [
    "Benchmark and test-set design",
    "Build representative GIS tasks with clear instructions, required inputs, constraints, and expected outputs.",
  ],
  [
    "Expert output review",
    "Review outputs against GIS practice instead of relying on a plausible-looking map or a passing narrative.",
  ],
  [
    "Objective rubrics",
    "Define inspectable criteria for correctness, spatial tolerance, schema, provenance, cartography, and instruction following.",
  ],
  [
    "Failure taxonomy",
    "Classify error patterns so teams can distinguish geometry, CRS, join, spatial-analysis, and workflow failures.",
  ],
  [
    "Regression testing",
    "Turn observed failures into a regression pack that can be rerun after product or model changes.",
  ],
];
---

<Layout
  title="Geospatial AI Evaluation | Brooks Geospatial"
  description="Geospatial AI evaluation for GIS agents, mapping tools, geocoders, spatial-data pipelines, and remote-sensing systems."
  canonicalPath="/ai-evaluation"
>
  <Navbar />
  <main id="main-content">
    <PageHero
      eyebrow="AI evaluation"
      title="Plausible-looking GIS output can still be spatially wrong."
      description="Brooks Geospatial designs evaluations that distinguish a convincing answer from an accurate, reproducible, and defensible spatial result."
    />
    <section class="bg-[#f6f2ea] px-4 py-16 text-[#10232d] sm:px-6 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.9fr_1.1fr]">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#116f6c]">
            What evaluation examines
          </p><h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            Test real GIS work, not just whether an answer sounds right.
          </h2>
        </div><div class="space-y-5 text-lg leading-8 text-slate-700">
          <p>
            A system can return a polished map, a reasonable place name, or a confident explanation while
            still using the wrong coordinate system, applying an invalid join, missing records, or producing
            geometry that does not support the conclusion.
          </p><p>
            Evaluation makes those conditions visible with realistic tasks, known inputs, expert reference
            outputs, measurable scoring criteria, and documented failure evidence.
          </p>
        </div>
      </div>
    </section>
    <section class="bg-[#0c202d] px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8de6da]">Evaluation practice</p><h2
            class="mt-4 text-3xl font-bold tracking-tight text-[#f6f2ea] sm:text-4xl"
          >
            Evidence that product, research, and QA teams can inspect.
          </h2>
        </div><div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            practices.map(([title, body], index) => (
              <article class="border border-white/10 bg-[#07151f] p-6">
                <>
                  <span class="font-mono text-sm text-[#8de6da]">0{index + 1}</span>
                  <h3 class="mt-5 text-xl font-bold text-[#f6f2ea]">{title}</h3>
                  <p class="mt-3 leading-7 text-slate-300">{body}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="bg-[#d8e3eb] px-4 py-16 text-[#10232d] sm:px-6 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#116f6c]">Deliverables</p><h2
          class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          A complete evaluation package can include:
        </h2><ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            deliverables.map((item, index) => (
              <li class="border border-[#9db5c2] bg-[#edf3f6] p-5">
                <>
                  <span class="font-mono text-sm font-bold text-[#116f6c]">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="mt-5 font-bold">{item}</p>
                </>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <section class="bg-[#07151f] px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-6 md:flex-row md:items-center">
        <div>
          <h2 class="text-3xl font-bold text-[#f6f2ea]">Start with an evaluation pilot.</h2><p
            class="mt-3 max-w-2xl leading-7 text-slate-300"
          >
            A focused task set can surface how a system handles real spatial work before an evaluation
            expands.
          </p>
        </div><a
          href="/contact"
          data-analytics-event="demo_click"
          class="inline-flex min-h-12 items-center justify-center bg-[#238e89] px-6 py-3 font-bold text-white hover:bg-[#2ab7a9]"
          >Discuss an Evaluation Pilot</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>
