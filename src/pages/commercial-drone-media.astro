---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

const services = [
    "Drone photography",
    "Drone video",
    "Property and venue flyovers",
    "Real estate and land media",
    "Construction and progress documentation",
    "Marketing media packages",
    "Social-ready vertical videos",
];

const groundPhotos = [
    "/GroundStills/FAVCC_2026_Full-17.jpg",
    "/GroundStills/FAVCC_2026_Full-21.jpg",
    "/GroundStills/FAVCC_2026_Full-39.jpg",
    "/GroundStills/FAVCC_2026_Full-60.jpg",
    "/GroundStills/FAVCC_2026_Full-69.jpg",
];

const droneStills = [
    "/DroneStills/FAVCC_2026_Full-3.jpg",
    "/DroneStills/FAVCC_2026_Full-4.jpg",
    "/DroneStills/FAVCC_2026_Full-14.jpg",
];

const verticalVideos = [
    "/Vids/copy_500567E9-EAD9-4B27-889C-9ED703EE4F47.MOV",
    "/Vids/copy_BF4594C2-3DC2-4D64-8E11-88CC2652DC7D.MOV",
];
---

<Layout title="Commercial Drone Media | Brooks Geospatial">
    <Navbar />

    <section class="relative min-h-[86vh] flex items-end overflow-hidden bg-slate-950 pt-28">
        <div class="absolute inset-0 z-0">
            <img
                src="/DroneStills/FAVCC_2026_Full-14.jpg"
                alt="Aerial view of a local country club"
                class="h-full w-full object-cover opacity-70"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/20"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/60"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 pb-20 w-full">
            <div class="max-w-3xl">
                <p class="text-sm font-bold uppercase tracking-[0.25em] text-teal-300 mb-5">
                    Commercial Drone Media
                </p>
                <h1 class="text-4xl md:text-6xl font-bold leading-tight text-white mb-6">
                    Commercial Drone Media for Fayette County Businesses
                </h1>
                <p class="text-lg md:text-xl text-slate-200 leading-relaxed mb-8">
                    Brooks Geospatial helps local businesses, venues, properties, and organizations show their space from a better angle with professional drone photography, aerial video, and polished media packages.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href="/contact"
                        class="bg-teal-500 text-white px-8 py-4 rounded font-bold hover:bg-teal-400 transition shadow-lg shadow-teal-900/20 text-center"
                    >
                        Book a Media Package
                    </a>
                    <a
                        href="#recent-work"
                        class="bg-slate-900/70 border border-white/10 text-white px-8 py-4 rounded font-bold hover:border-teal-400 hover:bg-slate-900 transition text-center"
                    >
                        View Recent Work
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-slate-950">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-[1fr_1.15fr] gap-12 items-start">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                        Media built for the places people already find you.
                    </h2>
                    <p class="text-slate-300 text-lg leading-relaxed mb-6">
                        From real estate and land to golf courses, restaurants, dealerships, event venues, and recreation spaces, we create photo and video assets your business can use on your website, Google Business Profile, Facebook, Instagram, ads, brochures, and sales materials.
                    </p>
                    <p class="text-slate-400 leading-relaxed">
                        Each package is planned around how the final content will be used, so the shoot can cover wide establishing views, ground-level detail, vertical social clips, and polished hero visuals in one coordinated visit.
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                    {services.map((service) => (
                        <div class="bg-slate-900 border border-slate-800 rounded-lg p-5 hover:border-teal-500/50 transition">
                            <div class="w-10 h-10 rounded bg-teal-500/10 text-teal-300 flex items-center justify-center mb-4">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3H4a1 1 0 0 0-1 1v5.59A2 2 0 0 0 3.59 11l9.59 9.59a2 2 0 0 0 2.82 0l4.59-4.59a2 2 0 0 0 0-2.82Z"/><path d="M7 7h.01"/></svg>
                            </div>
                            <h3 class="text-white font-bold text-lg">{service}</h3>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="py-16 bg-slate-900 border-y border-slate-800">
        <div class="max-w-5xl mx-auto px-6 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-5">
                Need photos, drone video, and content for your business?
            </h2>
            <p class="text-slate-300 text-lg mb-8">
                Book a local business media package.
            </p>
            <a
                href="/contact"
                class="inline-flex bg-teal-500 text-white px-8 py-4 rounded font-bold hover:bg-teal-400 transition shadow-lg shadow-teal-900/20"
            >
                Book a Local Business Media Package
            </a>
        </div>
    </section>

    <section id="recent-work" class="py-24 bg-slate-950">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-center mb-16">
                <div>
                    <p class="text-sm font-bold uppercase tracking-[0.25em] text-teal-300 mb-5">
                        Recent Work
                    </p>
                    <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">
                        Country Club Media Package
                    </h2>
                    <p class="text-slate-300 text-lg leading-relaxed mb-6">
                        We recently created a full media package for a local country club, including professional photos, drone footage, short-form video clips, and reusable marketing assets. The final package gave the client fresh content for social media, their website, member communication, and future promotions.
                    </p>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-slate-900 rounded-lg border border-slate-800 p-5">
                            <p class="text-3xl font-bold text-teal-300 mb-1">5</p>
                            <p class="text-slate-400">Ground photos featured</p>
                        </div>
                        <div class="bg-slate-900 rounded-lg border border-slate-800 p-5">
                            <p class="text-3xl font-bold text-teal-300 mb-1">3</p>
                            <p class="text-slate-400">Drone stills featured</p>
                        </div>
                        <div class="bg-slate-900 rounded-lg border border-slate-800 p-5">
                            <p class="text-3xl font-bold text-teal-300 mb-1">1</p>
                            <p class="text-slate-400">Hero video example</p>
                        </div>
                        <div class="bg-slate-900 rounded-lg border border-slate-800 p-5">
                            <p class="text-3xl font-bold text-teal-300 mb-1">2</p>
                            <p class="text-slate-400">Vertical video examples</p>
                        </div>
                    </div>
                </div>

                <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900 shadow-2xl">
                    <video
                        class="w-full aspect-video object-cover bg-slate-950"
                        controls
                        playsinline
                        poster="/DroneStills/FAVCC_2026_Full-3.jpg"
                    >
                        <source src="/Vids/copy_500567E9-EAD9-4B27-889C-9ED703EE4F47.MOV" />
                    </video>
                </div>
            </div>

            <div class="mb-16">
                <div class="flex items-end justify-between gap-6 mb-8">
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                        Ground Photography
                    </h3>
                    <p class="text-slate-500 text-sm uppercase tracking-widest">
                        5 selected images
                    </p>
                </div>
                <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
                    {groundPhotos.map((photo, index) => (
                        <figure class="group overflow-hidden rounded-lg border border-slate-800 bg-slate-900 aspect-[4/5]">
                            <img
                                src={photo}
                                alt={`Country club ground photo ${index + 1}`}
                                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                loading="lazy"
                            />
                        </figure>
                    ))}
                </div>
            </div>

            <div class="mb-16">
                <div class="flex items-end justify-between gap-6 mb-8">
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                        Drone Stills
                    </h3>
                    <p class="text-slate-500 text-sm uppercase tracking-widest">
                        3 aerial images
                    </p>
                </div>
                <div class="grid md:grid-cols-3 gap-4">
                    {droneStills.map((photo, index) => (
                        <figure class="group overflow-hidden rounded-lg border border-slate-800 bg-slate-900 aspect-video">
                            <img
                                src={photo}
                                alt={`Country club drone still ${index + 1}`}
                                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                loading="lazy"
                            />
                        </figure>
                    ))}
                </div>
            </div>

            <div>
                <div class="flex items-end justify-between gap-6 mb-8">
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                        Short Vertical Video Examples
                    </h3>
                    <p class="text-slate-500 text-sm uppercase tracking-widest">
                        Social-ready clips
                    </p>
                </div>
                <div class="grid sm:grid-cols-2 gap-6 max-w-4xl">
                    {verticalVideos.map((video, index) => (
                        <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-900">
                            <video
                                class="w-full aspect-[9/16] object-cover bg-slate-950"
                                controls
                                playsinline
                                preload="metadata"
                            >
                                <source src={video} />
                            </video>
                            <div class="p-5">
                                <h4 class="font-bold text-white">Vertical Clip {index + 1}</h4>
                                <p class="text-slate-400 text-sm mt-1">
                                    Formatted for Reels, Stories, Shorts, and paid social placements.
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <footer class="py-12 bg-slate-950 border-t border-slate-800 text-center">
        <div class="flex justify-center mb-4">
            <img
                src="/logo2.png"
                alt="Brooks Geospatial"
                class="h-8 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition duration-500"
            />
        </div>
        <p class="text-slate-600 text-sm">
            &copy; 2025 Brooks Geospatial. All rights reserved.
        </p>
    </footer>
</Layout>
