---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects.mjs";
---

<Layout
  title="Drone Photography & Commercial Media | Brooks Geospatial"
  description="Professional drone photography, aerial video, property flyovers, and local business media packages in Fayette County and Central Texas."
>
  <Navbar /><main id="main-content">
    <PageHero
      eyebrow="Aerial imagery & commercial media"
      title="Make a lasting first impression."
      description="Professional drone photography, aerial video, and polished media for the places you’re proud of. Show your business, property, or venue from a fresh perspective."
      ><div class="hero-actions">
        <a class="button button-dark" href="/contact?service=Aerial%20imagery"
          >Plan a media package<Icon name="northeast" size={18} /></a
        ><a class="text-link" href="#drone-work">See the work<Icon name="arrow" size={18} /></a>
      </div></PageHero
    >
    <div class="container">
      <img
        class="wide-photo"
        src="/images/work/country-club-aerial.webp"
        alt="Expansive aerial view of a local country club and its green fairways"
        width="1800"
        height="1200"
        fetchpriority="high"
      />
    </div>
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Aerial perspective. Practical purpose.</p><h2>
              Media made for<br />where your story lives.
            </h2>
          </div><p>
            Website banners, real estate listings, social posts, brochures, and member communications. We plan
            the shoot around how you’ll use the work.
          </p>
        </div>
        <div class="service-grid">
          <div class="service-card">
            <div class="service-card-top"><Icon name="drone" size={34} /><span>01</span></div><h3>
              Photography & video
            </h3><p>
              High-resolution drone photography, aerial video, and property flyovers that place your space in
              its surroundings.
            </p>
          </div><div class="service-card">
            <div class="service-card-top"><Icon name="pin" size={34} /><span>02</span></div><h3>
              Property & land media
            </h3><p>
              Show the layout, character, and setting of real estate, rural land, recreation spaces, and
              commercial properties.
            </p>
          </div><div class="service-card">
            <div class="service-card-top"><Icon name="layers" size={34} /><span>03</span></div><h3>
              Business media packages
            </h3><p>
              A coordinated collection of aerial views, ground photography, and social-ready video for
              businesses and venues.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="section selected-work" id="drone-work">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Selected aerial work</p><h2>A new angle on familiar places.</h2></div>
        </div><div class="work-grid portfolio-grid">
          {
            projects
              .filter((p) => p.category === "Aerial imagery")
              .map((project, index) => <ProjectCard project={project} index={index} />)
          }
        </div>
      </div>
    </section><ProjectCTA />
  </main><Footer />
</Layout>
