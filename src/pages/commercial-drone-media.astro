  description="Brooks Geospatial now focuses on geospatial AI evaluation and GIS quality assurance."
  redirectTo="/projects"
  noindex
>
  <main id="main-content" class="flex min-h-screen items-center justify-center bg-[#07151f] px-6 text-center">
    <div>
      <h1 class="text-3xl font-bold text-[#f6f2ea]">Brooks Geospatial has updated.</h1><p
        class="mt-4 max-w-xl text-slate-300"
      >
        Explore current work in geospatial AI evaluation and GIS quality assurance.
      </p><a href="/projects" class="mt-7 inline-flex bg-[#238e89] px-5 py-3 font-bold text-white"
        >View projects</a
      >
    </div>
  </main>
</Layout>
