---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import PropertyReportForm from "../components/PropertyReportForm.astro";

const sampleReport = "/downloads/Brooks_Geospatial_Property_Intelligence_Sample.pdf";
const modules = [
  "Parcel & aerial mapping",
  "FEMA flood conditions",
  "Terrain & slope",
  "Soils",
  "Mapped wetlands & water features",
  "Road & transportation context",
  "Groundwater information",
  "Planning, zoning & jurisdiction data",
  "Demographics & market context",
  "Surrounding parcels / ownership context",
  "Infrastructure information",
  "Spatial measurements & calculated acreage",
];
const audiences = [
  ["Land & Ranch Brokers", "Use property intelligence as a professional listing and buyer-education tool."],
  ["Land Buyers & Investors", "Organize public information before committing to deeper due diligence."],
  ["Commercial Brokers & Developers", "Understand mapped conditions, access, demographics, planning context, and other site factors."],
  ["Engineers & Consultants", "Receive an organized GIS research package before more specialized work begins."],
  ["Property Owners", "Better understand the public GIS information associated with a property."],
];
const levels = [
  ["Property Snapshot", "Starting around $149", "A concise property screen including parcel information, aerial mapping, FEMA flood analysis, key findings, and source documentation."],
  ["Property Intelligence Report", "Starting around $249", "Expanded analysis using additional datasets appropriate to the property, potentially including terrain, soils, wetlands, access, planning/zoning, surrounding parcels, and other relevant layers."],
  ["Development / Site Intelligence", "Custom quote", "More detailed acquisition, development, commercial, site-selection, or multi-property analysis."],
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Property Intelligence Reports",
  serviceType: "Property GIS research and mapping",
  provider: { "@type": "ProfessionalService", name: "Brooks Geospatial", url: "https://brooksgeospatial.com" },
  areaServed: "Central Texas",
  description: "Property-specific GIS research reports combining parcel data, aerial imagery, FEMA flood analysis, professional mapping, and public-data research.",
};
---

<Layout
  title="Property Intelligence Reports | Brooks Geospatial"
  description="Professional property intelligence reports combining parcel data, aerial imagery, FEMA flood analysis, GIS mapping, and public-data research for land, commercial, and development decisions."
  image="/images/property-intelligence/property-snapshot.png"
  structuredData={structuredData}
>
  <Navbar />
  <main id="main-content">
    <section class="property-hero">
      <div class="container property-hero-grid">
        <div class="property-hero-copy">
          <p class="eyebrow"><span class="accent-dot"></span>Property intelligence</p>
          <h1>Understand the property before the next decision.</h1>
          <p class="property-hero-lede">Brooks Geospatial turns scattered public GIS data into clear, property-specific research.</p>
          <p class="property-hero-support">Our reports combine professional mapping with measured spatial analysis to help landowners, buyers, brokers, developers, investors, and consultants better understand a property before moving into more specialized due diligence.</p>
          <div class="hero-actions property-hero-actions">
            <a class="button button-dark" href="#request-report" data-analytics-event="property_report_request_click">Request a Property Report <Icon name="northeast" size={18} /></a>
            <a class="text-link" href={sampleReport} target="_blank" rel="noopener" data-analytics-event="property_sample_report_click">View Sample Report <Icon name="northeast" size={18} /></a>
          </div>
        </div>
        <a class="hero-report-preview" href={sampleReport} target="_blank" rel="noopener" aria-label="View the full sample Property Intelligence Report in a new tab">
          <img src="/images/property-intelligence/property-snapshot.png" alt="Sample Property Intelligence Report showing an executive property snapshot" width="1800" height="1390" fetchpriority="high" />
          <span>Sample Property Intelligence Report <Icon name="northeast" size={16} /></span>
        </a>
      </div>
    </section>

    <section class="property-intro section">
      <div class="container property-intro-grid">
        <div><p class="eyebrow"><span class="section-number">01 /</span> The work</p><h2>Property research is scattered.</h2></div>
        <div>
          <p>A single property may require information from appraisal districts, FEMA, aerial imagery, local GIS systems, transportation agencies, soil databases, environmental datasets, and other public sources.</p>
          <p>Property Intelligence Reports organize relevant information into one professional deliverable with clear maps, measured results, source documentation, and limitations.</p>
          <p class="property-note">Available data varies by location and intended use.</p>
        </div>
      </div>
    </section>

    <section class="property-modules section">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow"><span class="section-number">02 /</span> Available analysis</p><h2>The right layers for the question.</h2></div><p>Available analysis varies by property, geography, data availability, and intended use.</p></div>
        <div class="module-grid">{modules.map((module, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><p>{module}</p></div>)}</div>
      </div>
    </section>

    <section class="property-audience section">
      <div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="section-number">03 /</span> Who it’s for</p><h2>Built for decisions involving land.</h2></div></div><div class="audience-grid">{audiences.map(([title, copy]) => <article><h3>{title}</h3><p>{copy}</p></article>)}</div></div>
    </section>

    <section class="property-levels section">
      <div class="container"><div class="section-heading"><div><p class="eyebrow"><span class="section-number">04 /</span> Report options</p><h2>Choose the right starting point.</h2></div><p>Service categories are shaped around the property, the available public data, and the decision at hand.</p></div><div class="levels-grid">{levels.map(([title, price, copy], index) => <article class:list={{ featured: index === 1 }}><span class="level-number">0{index + 1}</span><h3>{title}</h3><p class="level-price">{price}</p><p>{copy}</p><a class="text-link" href="#request-report">Request this report <Icon name="northeast" size={17} /></a></article>)}</div></div>
    </section>

    <section class="sample-report-section section">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow"><span class="section-number">05 /</span> A closer look</p><h2>Sample Property Intelligence Report</h2></div><div class="sample-heading-copy"><p>Core Property & Flood Screening</p><a class="text-link" href={sampleReport} target="_blank" rel="noopener" data-analytics-event="property_sample_report_click">View Full Sample Report <Icon name="northeast" size={18} /></a></div></div>
        <div class="sample-feature"><figure><img src="/images/property-intelligence/property-snapshot.png" alt="Property Intelligence Report property snapshot page" width="1800" height="1390" loading="lazy" /></figure><div><p class="eyebrow">Property at a glance</p><h3>Key parcel measurements and mapped conditions summarized clearly.</h3><p>The sample is a focused public-data screen—not the most comprehensive report possible. It shows how sources, findings, measurements, and limitations are communicated together.</p></div></div>
        <div class="report-preview-grid">
          <figure><img src="/images/property-intelligence/property-aerial-parcel.png" alt="Aerial and parcel map from the sample report" width="1800" height="1390" loading="lazy" /><figcaption><strong>Clear property context</strong><span>Professional aerial and parcel mapping centered on the subject property.</span></figcaption></figure>
          <figure><img src="/images/property-intelligence/property-fema-analysis.png" alt="FEMA flood analysis map from the sample report" width="1800" height="1390" loading="lazy" /><figcaption><strong>Measured spatial analysis</strong><span>Brooks Geospatial calculates how much of a property intersects mapped conditions rather than simply displaying GIS layers.</span></figcaption></figure>
        </div>
      </div>
    </section>

    <section class="property-request section" id="request-report">
      <div class="container property-request-grid"><div><p class="eyebrow"><span class="accent-dot"></span>Request a report</p><h2>Start with the property.</h2><p>Send us the property address, parcel ID, or listing link. We’ll review available data and determine the appropriate report before work begins.</p><div class="request-steps"><span>01 <b>Send the property.</b></span><span>02 <b>We review the available data.</b></span><span>03 <b>We recommend the right scope.</b></span></div></div><PropertyReportForm /></div>
      <div class="container"><p class="property-disclaimer">Property Intelligence Reports are preliminary public-data research products. They do not replace surveys, title review, engineering, environmental studies, appraisals, flood determinations, zoning confirmations, insurance determinations, or legal advice.</p><p class="property-disclaimer">Report content varies by location and intended use based on the availability, currency, licensing, and suitability of public datasets.</p></div>
    </section>
  </main>
  <Footer />
</Layout>
