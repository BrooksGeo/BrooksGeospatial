---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site.mjs";
---

<Layout
  title="Start a Project | Contact Brooks Geospatial"
  description="Talk to Brooks Geospatial about GIS mapping, drone photography, commercial media, or site documentation in Fayette County and Central Texas."
>
  <Navbar /><main id="main-content">
    <PageHero
      eyebrow="Let’s work together"
      title="What’s your next perspective?"
      description="Tell us what you’re working on. Whether you need a map, a fresh set of aerial images, or a clearer view of your site, we’d like to hear about it."
    />
    <div class="container contact-layout">
      <div class="contact-info">
        <h2>Start with a conversation.</h2><p>
          Share a little about your project, its location, and what you’d like to accomplish. Mac will follow
          up to discuss the scope and next steps.
        </p><div class="contact-detail">
          <Icon name="mail" /><div>
            <span>Email Mac directly</span><a
              href={`mailto:${site.contact.email}`}
              data-analytics-event="email_click">{site.contact.email}</a
            >
          </div>
        </div><div class="contact-detail">
          <Icon name="pin" /><div>
            <span>Based in Texas</span><p>Serving Fayette County & Central Texas</p>
          </div>
        </div><div class="contact-detail">
          <Icon name="drone" /><div>
            <span>Your project, in experienced hands</span><p>GIS analyst & FAA Part 107 drone pilot</p>
          </div>
        </div>
      </div><ContactForm />
    </div>
  </main><Footer />
</Layout>
