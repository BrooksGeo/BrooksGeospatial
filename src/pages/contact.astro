---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Contact | Brooks Geospatial">
    
    <Navbar />

    <section class="relative pt-32 pb-20 bg-slate-900 overflow-hidden">
        <div class="absolute inset-0 z-0">
             <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-transparent to-slate-950"></div>
             <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"></div>
        </div>
        
        <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white tracking-tight">
                Discuss a <span class="text-teal-400">Project</span>
            </h1>
            <p class="text-xl text-slate-400 max-w-2xl mx-auto font-light">
                Share the site, timeline, and deliverable you need. Brooks Geospatial will respond with practical next steps.
            </p>
        </div>
    </section>

    <section class="pb-24 bg-slate-950 relative">
        <div class="max-w-6xl mx-auto px-6">
            
            <div class="grid md:grid-cols-2 gap-12 bg-slate-900/50 p-8 md:p-12 rounded-lg border border-white/10">
                
                <div>
                    <h2 class="text-2xl font-bold text-white mb-6">Send a Message</h2>
                    
                    <form action="https://formsubmit.co/mac@brooksgeospatial.com" method="POST" class="space-y-6">
                        
                        <input type="text" name="_honey" style="display:none">
                        <input type="hidden" name="_captcha" value="false">
                        
                        <input type="hidden" name="_next" value="https://brooksgeospatial.com/contact">
                        
                        <input type="hidden" name="_subject" value="New Website Inquiry!">

                        <div>
                            <label for="name" class="block text-sm font-medium text-slate-400 mb-2">Name</label>
                            <input type="text" name="name" id="name" required 
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition"
                                placeholder="Your Full Name" />
                        </div>

                        <div>
                            <label for="email" class="block text-sm font-medium text-slate-400 mb-2">Email</label>
                            <input type="email" name="email" id="email" required 
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition"
                                placeholder="name@company.com" />
                        </div>

                        <div>
                            <label for="message" class="block text-sm font-medium text-slate-400 mb-2">Message</label>
                            <textarea name="message" id="message" rows="4" required
                                class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition"
                                placeholder="Location, deadline, and what you need delivered"></textarea>
                        </div>

                        <button type="submit" class="w-full bg-teal-500 text-white font-bold py-4 rounded-lg hover:bg-teal-400 transition shadow-lg hover:shadow-teal-500/20">
                            Send Message
                        </button>
                    </form>
                </div>

                <div class="flex flex-col justify-center space-y-10 border-t md:border-t-0 md:border-l border-white/10 pt-10 md:pt-0 md:pl-12">
                    
                    <div>
                        <div class="w-12 h-12 bg-teal-500/10 rounded-lg flex items-center justify-center text-teal-400 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2">Email</h3>
                        <p class="text-slate-400 mb-2">For project inquiries, portfolio review, or professional opportunities:</p>
                        <a href="mailto:mac@brooksgeospatial.com" class="text-xl text-teal-400 font-semibold hover:text-white transition">
                            mac@brooksgeospatial.com
                        </a>
                    </div>

                    <div>
                        <div class="w-12 h-12 bg-teal-500/10 rounded-lg flex items-center justify-center text-teal-400 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2">Typical Project Details</h3>
                        <p class="text-slate-400">Site address or area, intended audience, preferred deadline, and whether you need photos, video, maps, or exhibits.</p>
                    </div>

                    <div>
                        <h3 class="text-lg font-bold text-white mb-3">Capabilities</h3>
                        <div class="flex flex-wrap gap-2 text-sm text-slate-300">
                            <span class="bg-slate-800 border border-white/10 rounded px-3 py-2">FAA Part 107</span>
                            <span class="bg-slate-800 border border-white/10 rounded px-3 py-2">GIS mapping</span>
                            <span class="bg-slate-800 border border-white/10 rounded px-3 py-2">Aerial video</span>
                            <span class="bg-slate-800 border border-white/10 rounded px-3 py-2">Property exhibits</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <footer class="py-12 bg-slate-950 border-t border-slate-800 text-center">
        <div class="flex justify-center mb-4">
             <img src="/logo2.png" alt="Brooks Geospatial" class="h-8 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition duration-500" />
        </div>
        <p class="text-slate-600 text-sm">&copy; 2026 Brooks Geospatial. All rights reserved.</p>
    </footer>

</Layout>
