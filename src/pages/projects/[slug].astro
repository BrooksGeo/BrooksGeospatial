---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import RedirectPage from "../../components/RedirectPage.astro";
import Icon from "../../components/Icon.astro";
import { projects } from "../../data/projects.mjs";
export function getStaticPaths() {
  return [
    ...projects.map((project) => ({ params: { slug: project.slug }, props: { project } })),
    ...["spatial-data-qa-toolkit", "geoeval-benchmark", "texas-geocoder-evaluation"].map((slug) => ({
      params: { slug },
      props: { project: null },
    })),
  ];
}
const { project } = Astro.props;
const imageExt = project?.imageExt ?? "webp";
const getPhotoImageExt = (photo: { image: string; alt: string; imageExt?: string }) => photo.imageExt ?? imageExt;
const structuredData = project
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://brooksgeospatial.com/" },
        {
          "@type": "ListItem",
          position: 2,
          name: "Our work",
          item: "https://brooksgeospatial.com/portfolio",
        },
        { "@type": "ListItem", position: 3, name: project.title },
      ],
    }
  : {};
---

{
  project ? (
    <Layout
      title={`${project.title} | Brooks Geospatial`}
      description={project.summary}
      image={`/images/work/${project.image}.${imageExt}`}
      structuredData={structuredData}
    >
      <>
        <Navbar />
        <main id="main-content">
          <section class="page-hero">
            <div class="container">
              <>
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                  <>
                    <a href="/">Home</a>
                    <span>/</span>
                    <a href="/portfolio">Our work</a>
                    <span>/</span>
                    <span aria-current="page">Project</span>
                  </>
                </nav>
                <p class="eyebrow">
                  <span class="accent-dot" />
                  {project.category} / {project.location}
                </p>
                <h1>{project.headline ?? project.title}</h1>
                <p>{project.summary}</p>
              </>
            </div>
          </section>
          <>
            <div class="container">
              <>
                <figure
                  class:list={["project-hero-image", { "is-map": project.category === "GIS & mapping" }]}
                >
                  <img
                    src={`/images/work/${project.image}.${imageExt}`}
                    alt={project.alt}
                    width="1800"
                    height="1200"
                    fetchpriority="high"
                  />
                </figure>
                <section class="project-details">
                  <>
                    <div>
                      <>
                        <p class="eyebrow">The perspective</p>
                        <h2>About the work.</h2>
                        <ul class="deliverable-list">
                          {project.deliverables.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </div>
                    <div>
                      <p>{project.description}</p>
                      {project.sampleReport && <p><a class="text-link" href={project.sampleReport} target="_blank" rel="noopener">View Sample Report <Icon name="northeast" size={17} /></a></p>}
                      {project.attribution && <p class="attribution">{project.attribution}</p>}
                      {project.note && <p class="project-note">{project.note}</p>}
                    </div>
                  </>
                </section>
              </>
              {project.gallery.length > 0 && (
                <div class="photo-gallery">
                  {project.gallery.map((photo) => (
                    <a
                      href={`/images/work/${photo.image}.${getPhotoImageExt(photo)}`}
                      class:list={["gallery-item", { "is-map": project.category === "GIS & mapping" }]}
                      data-gallery
                      aria-label={`Enlarge: ${photo.alt}`}
                    >
                      <img
                        src={`/images/work/${photo.image}-small.${getPhotoImageExt(photo)}`}
                        alt={photo.alt}
                        width="800"
                        height="600"
                        loading="lazy"
                      />
                    </a>
                  ))}
                </div>
              )}
            </div>
            <ProjectCTA />
          </>
        </main>
        <Footer />
      </>
      <dialog class="lightbox" aria-label="Project image viewer">
        <>
          <button type="button" aria-label="Close image">
            <Icon name="cross" />
          </button>
          <img alt="" />
          <p />
        </>
      </dialog>
    </Layout>
  ) : (
    <RedirectPage to="/portfolio" label="Our work" />
  )
}
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  let trigger: HTMLElement | null = null;
  document.querySelectorAll<HTMLAnchorElement>("[data-gallery]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!dialog) return;
      event.preventDefault();
      trigger = link;
      const image = dialog.querySelector<HTMLImageElement>("img")!;
      image.src = link.href;
      image.alt = link.querySelector("img")?.alt ?? "Project image";
      dialog.querySelector("p")!.textContent = image.alt;
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });
  });
  dialog?.querySelector("button")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close();
    }
  });
  dialog?.addEventListener("close", () => {
    document.body.style.overflow = "";
    trigger?.focus();
  });
</script>
