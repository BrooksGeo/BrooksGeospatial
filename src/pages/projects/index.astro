---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects.mjs";
---

<Layout
  title="Evaluation Projects | Brooks Geospatial"
  description="In-progress geospatial AI evaluation and GIS quality-assurance project work from Brooks Geospatial."
  canonicalPath="/projects"
>
  <Navbar />
  <main id="main-content">
    <PageHero
      eyebrow="Projects"
      title="Geospatial evaluation projects"
      description="Structured project pages identify current scope, intended deliverables, and publication status without exposing confidential client data."
    /><section class="bg-[#07151f] px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-5 lg:grid-cols-3">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
