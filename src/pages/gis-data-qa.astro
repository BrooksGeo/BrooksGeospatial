---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";

const checks = [
  [
    "CRS, units, and extent",
    "Confirm coordinate reference systems, unit assumptions, coverage, and spatial extent before analysis or publication.",
  ],
  [
    "Geometry and topology",
    "Review invalid geometry, gaps, overlaps, containment, adjacency, and other spatial relationships.",
  ],
  [
    "Schema and domain checks",
    "Check field names, types, coded values, required attributes, and constraints against the intended data model.",
  ],
  [
    "Duplicates, nulls, and orphans",
    "Identify duplicated records, missing values, and unmatched relationships that can distort an output.",
  ],
  [
    "Joins and record counts",
    "Validate join keys, match rates, expected counts, and whether records were added, excluded, or multiplied.",
  ],
  [
    "Geocoding review",
    "Review location matches, coordinates, ambiguity, and spatial tolerance instead of accepting a point at face value.",
  ],
  [
    "Lineage documentation",
    "Record sources, transformations, assumptions, and limitations so results can be understood and recreated.",
  ],
  [
    "Cartographic QA",
    "Check labels, legends, symbology, scale, hierarchy, and whether a map communicates the intended analytical result.",
  ],
  [
    "Workflow documentation",
    "Document repeatable steps and Python-assisted checks where they improve consistency and reviewability.",
  ],
];
---

<Layout
  title="GIS & Data QA | Brooks Geospatial"
  description="GIS and spatial-data quality assurance for coordinate systems, geometry, records, joins, geocoding, maps, lineage, and workflows."
  canonicalPath="/gis-data-qa"
>
  <Navbar />
  <main id="main-content">
    <PageHero
      eyebrow="GIS & data QA"
      title="Spatial data needs checks that go beyond looking right on a map."
      description="Review the coordinate, geometry, schema, record, and workflow conditions that determine whether a spatial output is defensible."
    />
    <section class="bg-[#f6f2ea] px-4 py-16 text-[#10232d] sm:px-6 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#116f6c]">
            Quality-assurance coverage
          </p><h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            Inspect the spatial conditions behind the final output.
          </h2><p class="mt-5 text-lg leading-8 text-slate-700">
            GIS QA is strongest when it checks both data integrity and the workflow that produces a result.
          </p>
        </div><div
          class="mt-10 grid gap-px overflow-hidden border border-[#b8c9d2] bg-[#b8c9d2] md:grid-cols-2 lg:grid-cols-3"
        >
          {
            checks.map(([title, body]) => (
              <article class="bg-[#f6f2ea] p-6">
                <>
                  <h3 class="text-xl font-bold">{title}</h3>
                  <p class="mt-3 leading-7 text-slate-700">{body}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="bg-[#0c202d] px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8de6da]">How checks are used</p><h2
            class="mt-4 text-3xl font-bold tracking-tight text-[#f6f2ea] sm:text-4xl"
          >
            Make review criteria repeatable.
          </h2>
        </div><div class="space-y-5 text-lg leading-8 text-slate-300">
          <p>
            Some checks are manual because professional judgement is essential. Others can be assisted by
            Python or automated rules when the underlying requirement is objective and repeatable.
          </p><p>
            The work should make exceptions visible, document their impact, and preserve the instructions and
            inputs needed to reproduce the review.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
