---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site.mjs";
---

<Layout
  title="Davis “Mac” Brooks | Professional Background"
  description="GIS, market research, geography, and aerial operations experience of Davis Mac Brooks, founder of Brooks Geospatial."
>
  <Navbar /><main id="main-content">
    <PageHero
      eyebrow="Professional background"
      title="Davis “Mac” Brooks"
      description="GIS analyst · Founder of Brooks Geospatial · FAA Part 107 remote pilot"
    /><article class="container resume-content">
      <a class="text-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a><h2>
        Professional summary
      </h2><p>
        GIS analyst and founder of Brooks Geospatial with experience in market-area mapping, real estate
        feasibility research, spatial data work, and database maintenance. Combines GIS analysis with drone
        imagery and practical fieldwork.
      </p><h2>Experience</h2><h3>Capitol Market Research</h3><p>GIS Analyst Intern → GIS Analyst</p><ul>
        <li>Performed market-area mapping and real estate feasibility research.</li><li>
          Maintained a database of more than 1,500 office, retail, and multifamily locations.
        </li>
      </ul><h3>Brooks Geospatial</h3><p>
        Founder — GIS mapping, spatial analysis, aerial photography, commercial drone media, and site
        documentation.
      </p><h2>Education</h2><h3>Texas State University</h3><p>
        B.S. in Geography, Resource and Environmental Studies<br />Minor in Plant and Soil Science
      </p><h2>Skills & certification</h2><ul>
        <li>ArcGIS / ArcMap, map production, and geocoding</li><li>Spatial data management and Python</li><li>
          Real estate market and demographic research
        </li><li>FAA Part 107 Remote Pilot</li>
      </ul>
    </article>
  </main><Footer />
</Layout>
