---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site.mjs";
---

<Layout
  title="Resume | Davis “Mac” Brooks | Brooks Geospatial"
  description="Resume for Davis “Mac” Brooks, GIS analyst, founder of Brooks Geospatial, and FAA Part 107 remote pilot."
  canonicalPath="/resume"
>
  <Navbar />
  <main id="main-content">
    <section class="map-grid bg-[#0b2230] px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8de6da]">Resume</p><h1
          class="mt-4 text-4xl font-bold tracking-tight text-[#f6f2ea] sm:text-5xl"
        >
          Davis “Mac” Brooks
        </h1><p class="mt-5 max-w-3xl text-xl leading-8 text-slate-200">
          GIS Analyst · Founder, Brooks Geospatial · FAA Part 107 Remote Pilot
        </p><div id="downloads" class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.resume.pdf}
            data-analytics-event="resume_download"
            download
            class="inline-flex min-h-12 items-center justify-center bg-[#238e89] px-6 py-3 font-bold text-white hover:bg-[#2ab7a9]"
            >Download PDF</a
          ><a
            href={site.resume.docx}
            data-analytics-event="resume_download"
            download
            class="inline-flex min-h-12 items-center justify-center border border-[#8de6da]/70 px-6 py-3 font-bold text-[#f6f2ea] hover:bg-white/10"
            >Download DOCX</a
          >
        </div>
      </div>
    </section>
    <article class="bg-[#f6f2ea] px-4 py-16 text-[#10232d] sm:px-6 sm:py-24">
      <div class="mx-auto max-w-4xl">
        <header class="border-b-4 border-[#238e89] pb-8">
          <h2 class="text-3xl font-bold tracking-tight">Davis “Mac” Brooks</h2><p
            class="mt-2 font-semibold text-[#116f6c]"
          >
            GIS Analyst · Founder, Brooks Geospatial · FAA Part 107 Remote Pilot
          </p><a
            href={`mailto:${site.contact.email}`}
            data-analytics-event="email_click"
            class="mt-4 inline-flex font-bold text-[#116f6c] underline underline-offset-4 hover:text-[#10232d]"
            >{site.contact.email}</a
          >
        </header><section class="mt-10">
          <h2 class="text-2xl font-bold">Professional summary</h2><p class="mt-4 leading-8 text-slate-700">
            GIS analyst and founder of Brooks Geospatial with experience in market-area mapping, real-estate
            feasibility research, spatial-data work, and database maintenance. Current focus: geospatial AI
            evaluation and GIS quality assurance.
          </p>
        </section><section class="mt-10">
          <h2 class="text-2xl font-bold">Experience</h2><div class="mt-5 border-l-2 border-[#238e89] pl-5">
            <h3 class="text-xl font-bold">Capitol Market Research</h3><p
              class="mt-1 font-semibold text-[#116f6c]"
            >
              GIS Analyst Intern → GIS Analyst
            </p><ul class="mt-4 space-y-3 leading-7 text-slate-700">
              <li>Performed market-area mapping and real-estate feasibility research.</li><li>
                Maintained a database of more than 1,500 office, retail, and multifamily locations.
              </li>
            </ul>
          </div><div class="mt-7 border-l-2 border-[#238e89] pl-5">
            <h3 class="text-xl font-bold">Brooks Geospatial</h3><p class="mt-1 font-semibold text-[#116f6c]">
              Founder
            </p><p class="mt-4 leading-7 text-slate-700">
              Focused on geospatial AI evaluation, GIS quality assurance, spatial-data validation, and
              reproducible workflow testing.
            </p>
          </div>
        </section><section class="mt-10 grid gap-10 md:grid-cols-2">
          <div>
            <h2 class="text-2xl font-bold">Education</h2><h3 class="mt-5 text-xl font-bold">
              Texas State University
            </h3><p class="mt-2 leading-7 text-slate-700">
              B.S. in Geography, Resource and Environmental Studies
            </p><p class="leading-7 text-slate-700">Minor in Plant and Soil Science</p>
          </div><div>
            <h2 class="text-2xl font-bold">Skills and certification</h2><ul
              class="mt-5 space-y-3 leading-7 text-slate-700"
            >
              <li>ArcGIS / ArcMap</li><li>QGIS portfolio development</li><li>
                Python and spatial-data QA
              </li><li>FAA Part 107 Remote Pilot</li>
            </ul>
          </div>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
