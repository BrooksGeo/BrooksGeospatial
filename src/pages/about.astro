---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
---

<Layout
  title="About Brooks Geospatial | Davis “Mac” Brooks"
  description="Meet Davis “Mac” Brooks, founder of Brooks Geospatial, GIS analyst, Texas State geography graduate, and FAA Part 107–certified drone pilot."
>
  <Navbar /><main id="main-content">
    <PageHero
      eyebrow="About Brooks Geospatial"
      title="Local knowledge. A wider view."
      description="A Texas geospatial business connecting analytical experience, aerial imagery, and practical fieldwork."
    />
    <section class="section">
      <div class="container about-founder">
        <div>
          <p class="eyebrow"><span class="accent-dot"></span>Meet the founder</p><h2>Davis “Mac” Brooks</h2><p
          >
            Mac is a GIS analyst and FAA Part 107–certified drone pilot who brings together spatial data
            analysis, market research, and hands-on fieldwork.
          </p><p>
            A Texas State University graduate, he earned a B.S. in Geography, Resource and Environmental
            Studies, with a minor in Plant and Soil Science. His professional background includes market-area
            mapping, real estate feasibility research, and spatial data management at Capitol Market Research.
          </p><p>
            He founded Brooks Geospatial to make geographic information useful to the businesses, landowners,
            developers, and communities around him. From a map that explains a market to an aerial image that
            tells a property’s story, the purpose is the same: a clearer perspective.
          </p><ul class="deliverable-list">
            <li>GIS analyst</li><li>FAA Part 107 remote pilot</li><li>Texas State University</li>
          </ul>
        </div><figure>
          <img
            class="founder-photo"
            src="/images/mac-brooks.webp"
            alt="Davis Mac Brooks, founder of Brooks Geospatial"
            width="900"
            height="1000"
          /><figcaption class="founder-caption">DAVIS “MAC” BROOKS / FOUNDER</figcaption>
        </figure>
      </div>
    </section>
    <section class="expertise-strip">
      <div class="container expertise-grid">
        <div>
          <p class="eyebrow">01 / Spatial understanding</p><h3>GIS & cartography</h3><p>
            ArcGIS and ArcMap experience spanning geocoding, map production, and spatial data management.
          </p>
        </div><div>
          <p class="eyebrow">02 / On-site perspective</p><h3>Aerial operations</h3><p>
            Drone imagery, site documentation, and aerial data collection with an FAA Part 107–certified
            pilot.
          </p>
        </div><div>
          <p class="eyebrow">03 / Research with context</p><h3>Market & data analysis</h3><p>
            Real estate market studies, demographic research, and geographic analysis informed by Central
            Texas experience.
          </p>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="mission">
          <p class="eyebrow"><span class="accent-dot"></span>Why we do this</p><h2>
            To turn complex geographic information into clear, useful insight for the people shaping our
            communities.
          </h2>
        </div>
      </div>
    </section><ProjectCTA />
  </main><Footer />
</Layout>
