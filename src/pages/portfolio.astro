---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const projects = [
    {
        title: 'River Bend Site Overview',
        type: 'Aerial Site Documentation',
        image: '/HSLOA_02_Aerial_RiverBend_Bluffs.jpg',
        description: 'Wide-area imagery documenting river frontage, surrounding access, adjacent land use, and site context for review.'
    },
    {
        title: 'Property Boundary Exhibit',
        type: 'Real Estate Visualization',
        image: '/02_Aerial_PropertyOverview_Boundary.jpg',
        description: 'Aerial property view with boundary emphasis for client communication, marketing, and stakeholder orientation.'
    },
    {
        title: 'Land Context Survey',
        type: 'Planning Support',
        image: '/realproject5.JPG',
        description: 'Oblique aerial perspective showing terrain, vegetation patterns, road access, and surrounding development context.'
    },
    {
        title: 'Parcel Highlight View',
        type: 'Property Exhibit',
        image: '/realproject6.jpg',
        description: 'Selective-color parcel exhibit designed to isolate the subject property while preserving broader spatial context.'
    }
];
---

<Layout title="Portfolio | Brooks Geospatial">
    
    <Navbar />

    <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-slate-950 pt-28">
        <div class="absolute inset-0">
            <img src="/HSLOA_02_Aerial_RiverBend_Bluffs.jpg" alt="Aerial river bend project overview" class="w-full h-full object-cover opacity-45" />
            <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/75 to-slate-950/30"></div>
            <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-slate-950 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 w-full py-20">
            <div class="max-w-3xl">
                <p class="text-teal-300 text-sm font-bold uppercase tracking-wider mb-4">Portfolio</p>
                <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight mb-6">Aerial and GIS work built for clear review.</h1>
                <p class="text-xl text-slate-300 leading-relaxed">
                    Examples of site documentation, property exhibits, and aerial visuals that communicate location, access, boundaries, and field conditions.
                </p>
            </div>
        </div>
    </section>

    <section class="py-24 bg-slate-950">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 items-start mb-16">
                <div>
                    <p class="text-teal-400 text-sm font-bold uppercase tracking-wider mb-3">Featured Video</p>
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-5">Edited aerial media for property and project storytelling.</h2>
                    <p class="text-slate-400 text-lg leading-relaxed">
                        Video gives managers, clients, and stakeholders a fast understanding of site scale and surroundings. Brooks Geospatial pairs aerial capture with practical GIS context when a project requires more than standard photography.
                    </p>
                </div>
                <div class="border border-white/10 rounded-lg overflow-hidden bg-slate-900 shadow-2xl">
                    <video class="w-full aspect-video object-cover" controls playsinline poster="/HSLOA_02_Aerial_RiverBend_Bluffs.jpg">
                        <source src="/RediRealEstateEdit.mp4" type="video/mp4">
                    </video>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                {projects.map((project) => (
                    <article class="bg-slate-900 border border-slate-800 rounded-lg overflow-hidden">
                        <img src={project.image} alt={project.title} class="w-full h-72 object-cover" />
                        <div class="p-7">
                            <p class="text-teal-300 text-xs font-bold uppercase tracking-wider mb-3">{project.type}</p>
                            <h3 class="text-2xl font-bold text-white mb-3">{project.title}</h3>
                            <p class="text-slate-400 leading-relaxed">{project.description}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="py-20 bg-slate-900 border-t border-slate-800">
        <div class="max-w-5xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold text-white mb-5">Available deliverables</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-sm text-slate-300">
                <p class="border border-white/10 rounded-lg p-4 bg-slate-950/40">Edited aerial video</p>
                <p class="border border-white/10 rounded-lg p-4 bg-slate-950/40">High-resolution stills</p>
                <p class="border border-white/10 rounded-lg p-4 bg-slate-950/40">Boundary exhibits</p>
                <p class="border border-white/10 rounded-lg p-4 bg-slate-950/40">GIS map products</p>
            </div>
        </div>
    </section>

    <footer class="py-12 bg-slate-950 border-t border-slate-800 text-center">
        <div class="flex justify-center mb-4">
             <img src="/logo2.png" alt="Brooks Geospatial" class="h-8 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition duration-500" />
        </div>
        <p class="text-slate-600 text-sm">&copy; 2026 Brooks Geospatial. All rights reserved.</p>
    </footer>

</Layout>
