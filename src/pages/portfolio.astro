---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Projects have moved | Brooks Geospatial"
  description="Brooks Geospatial evaluation projects are now available at /projects."
  redirectTo="/projects"
  noindex
>
  <main id="main-content" class="flex min-h-screen items-center justify-center bg-[#07151f] px-6 text-center">
    <div>
      <h1 class="text-3xl font-bold text-[#f6f2ea]">Projects have moved.</h1><p class="mt-4 text-slate-300">
        Continue to the new Brooks Geospatial projects page.
      </p><a href="/projects" class="mt-7 inline-flex bg-[#238e89] px-5 py-3 font-bold text-white"
        >View projects</a
      >
    </div>
  </main>
</Layout>
