---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Page Not Found | Brooks Geospatial"
  description="Find your way back to Brooks Geospatial’s maps, imagery, and services."
  noindex
>
  <Navbar /><main id="main-content" class="container not-found">
    <p class="eyebrow">404 / A little off the map</p><h1>Let’s find your way back.</h1><p>
      This page may have moved. Explore our services or return to the homepage to find the perspective you’re
      looking for.
    </p><div class="hero-actions">
      <a class="button button-dark" href="/">Back to home<Icon name="arrow" size={18} /></a><a
        class="text-link"
        href="/portfolio">View our work</a
      >
    </div>
  </main><Footer />
</Layout>
