---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.mjs";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div><Brand footer /><p>A different perspective.<br />A clearer way forward.</p></div>
    <div class="footer-links">
      <span class="eyebrow">Explore</span><a href="/services">Our services</a><a href="/portfolio">Our work</a
      ><a href="/about">About Brooks Geospatial</a>
    </div>
    <div class="footer-contact">
      <span class="eyebrow">Let’s connect</span><a
        href={`mailto:${site.contact.email}`}
        data-analytics-event="email_click">{site.contact.email}<Icon name="northeast" size={16} /></a
      ><p>Fayette County & Central Texas</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Brooks Geospatial</span><span>GIS. Imagery. Insight.</span><a href="#main-content"
      >Back to top ↑</a
    >
  </div>
</footer>
