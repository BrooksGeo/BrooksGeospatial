---
import StatusBadge from "./StatusBadge.astro";

interface Project {
  slug: string;
  title: string;
  status: "in-progress" | "published";
  summary: string;
  focus: string[];
  repositoryUrl?: string;
  dashboardUrl?: string;
  dashboardThumbnail?: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article
  class="flex h-full flex-col border border-[#99b8c8]/25 bg-[#0c202d] p-6 shadow-[0_10px_32px_rgba(0,0,0,0.16)]"
>
  {
    project.dashboardUrl && project.dashboardThumbnail && (
      <a
        href={project.dashboardUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="dashboard_click"
        aria-label={`Open the live ArcGIS Dashboard for ${project.title} (opens in a new tab)`}
        class="group mb-6 block overflow-hidden border border-[#99b8c8]/30 bg-[#07151f]"
      >
        <img
          src={project.dashboardThumbnail.src}
          alt={project.dashboardThumbnail.alt}
          width={project.dashboardThumbnail.width}
          height={project.dashboardThumbnail.height}
          loading="lazy"
          decoding="async"
          class="block aspect-[2/1] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
        <span class="flex items-center justify-between gap-3 border-t border-[#99b8c8]/30 px-4 py-3 text-sm font-bold text-[#8de6da] group-hover:text-white">
          Live ArcGIS Dashboard <span aria-hidden="true">↗</span>
        </span>
      </a>
    )
  }
  <div class="flex items-start justify-between gap-4">
    <StatusBadge status={project.status} /><span class="font-mono text-xs text-slate-500"
      >/{project.slug}</span
    >
  </div>
  <h3 class="mt-6 text-2xl font-bold text-[#f6f2ea]">
    <a href={`/projects/${project.slug}`} class="rounded-sm hover:text-[#8de6da]">{project.title}</a>
  </h3>
  <p class="mt-3 leading-7 text-slate-300">{project.summary}</p>
  <ul class="mt-5 space-y-2 border-t border-white/10 pt-5 text-sm leading-6 text-slate-300">
    {
      project.focus.slice(0, 3).map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#54d7c5]" />
          {item}
        </li>
      ))
    }
  </ul>
  <div class="mt-7 flex flex-wrap items-center gap-4">
    <a href={`/projects/${project.slug}`} class="font-bold text-[#8de6da] hover:text-white"
      >View project details <span aria-hidden="true">→</span></a
    >
    {
      project.repositoryUrl && (
        <a
          href={project.repositoryUrl}
          data-analytics-event="project_repo_click"
          class="text-sm font-semibold text-slate-300 underline decoration-[#54d7c5] underline-offset-4 hover:text-white"
        >
          Repository
        </a>
      )
    }
  </div>
</article>
