---
import Icon from "./Icon.astro";
interface Props {
  project: (typeof import("../data/projects.mjs").projects)[number];
  index?: number;
}
const { project, index = 0 } = Astro.props;
---

<article class="work-card" data-category={project.category}>
  <a href={`/projects/${project.slug}`} class="work-image" aria-label={`View project: ${project.title}`}>
    <img
      src={`/images/work/${project.image}-small.webp`}
      alt={project.alt}
      width="800"
      height="540"
      loading="lazy"
      decoding="async"
      class:list={{ "map-image": project.category === "GIS & mapping" }}
    />
    <span class="image-category">{project.category}</span><span class="image-arrow"
      ><Icon name="northeast" /></span
    >
  </a>
  <div class="work-meta">
    <span>{project.location}</span><span>{String(index + 1).padStart(2, "0")}</span>
  </div>
  <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
  <p>{project.summary}</p>
</article>
