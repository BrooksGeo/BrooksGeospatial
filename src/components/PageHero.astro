---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow"><span class="accent-dot"></span>{eyebrow}</p><h1>{title}</h1><p>{description}</p><slot
    />
  </div>
</section>
