---
import { site } from "../data/site.mjs";
import Icon from "./Icon.astro";
const endpoint = `https://formsubmit.co/ajax/${site.contact.email}`;
const fallback = `https://formsubmit.co/${site.contact.email}`;
const serviceOptions = ["GIS & mapping", "Aerial imagery", "Site documentation", "A little of everything"];
---

<form id="contact-form" action={fallback} method="POST" data-endpoint={endpoint} class="contact-form">
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_subject" value="Brooks Geospatial project inquiry" />
  <div class="form-row">
    <label for="name">Your name <span aria-hidden="true">*</span></label><input
      id="name"
      name="name"
      autocomplete="name"
      required
      minlength="2"
      maxlength="120"
      placeholder="First and last name"
    />
  </div>
  <div class="form-row">
    <label for="email">Email address <span aria-hidden="true">*</span></label><input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength="254"
      placeholder="you@company.com"
    />
  </div>
  <div class="form-row">
    <label for="service">What can we help with?</label>
    <select id="service" name="service">
      <option value="">Choose a service (optional)</option>
      {serviceOptions.map((service) => <option value={service}>{service}</option>)}
    </select>
  </div>
  <div class="form-row">
    <label for="message">Tell us about your project <span aria-hidden="true">*</span></label><textarea
      id="message"
      name="message"
      rows="5"
      required
      minlength="20"
      maxlength="5000"
      placeholder="Your project, its location, and what you’d like to see."></textarea>
  </div>
  <button type="submit" class="button button-dark"
    ><span>Send project inquiry</span><Icon name="northeast" size={18} /></button
  >
  <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
  <p class="form-footnote">Prefer email? <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
</form>

<script>
  import { trackAnalytics } from "../lib/analytics";
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#form-status");
  const submitButton = form?.querySelector<HTMLButtonElement>("button[type='submit']");
  const buttonLabel = submitButton?.querySelector("span");
  const service = form?.querySelector<HTMLSelectElement>("#service");
  const requestedService = new URLSearchParams(window.location.search).get("service");
  if (
    service &&
    requestedService &&
    Array.from(service.options).some((option) => option.value === requestedService)
  )
    service.value = requestedService;
  let started = false;
  form?.addEventListener("focusin", () => {
    if (!started) {
      trackAnalytics("contact_form_start");
      started = true;
    }
  });
  // Keep native validation as the no-JavaScript fallback.
  if (form) form.noValidate = true;
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      if (status)
        status.textContent =
          "Please add your name, a valid email, and at least 20 characters about your project.";
      form.reportValidity();
      return;
    }
    if (!submitButton || !status || !buttonLabel || submitButton.disabled) return;
    submitButton.disabled = true;
    buttonLabel.textContent = "Sending…";
    status.textContent = "Sending your inquiry…";
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15000);
    try {
      const response = await fetch(form.dataset.endpoint ?? form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
        signal: controller.signal,
      });
      const result = await response.json();
      if (!response.ok || (result.success !== true && result.success !== "true"))
        throw new Error("Contact request not accepted");
      form.reset();
      status.textContent = "Thanks — your inquiry has been sent. Mac will be in touch.";
      trackAnalytics("contact_form_submission");
    } catch {
      status.textContent =
        "Your message could not be sent right now. Please email mac@brooksgeospatial.com instead. Your details are still here.";
    } finally {
      window.clearTimeout(timeout);
      submitButton.disabled = false;
      buttonLabel.textContent = "Send project inquiry";
    }
  });
</script>
