---
import { site } from "../data/site.mjs";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  redirectTo?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image = "/og-default.svg",
  structuredData = [],
  redirectTo,
  noindex = false,
} = Astro.props;
const pathname = redirectTo ?? canonicalPath ?? Astro.url.pathname;
const canonicalUrl = new URL(pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
const pageData = Array.isArray(structuredData) ? structuredData : [structuredData];
const organizationId = `${site.url}#professional-service`;
const personId = `${site.url}#person`;
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": organizationId,
    name: site.name,
    url: site.url,
    email: site.contact.email,
    description: site.description,
    founder: { "@id": personId },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: "Davis “Mac” Brooks",
    jobTitle: "GIS Analyst",
    worksFor: { "@id": organizationId },
    email: site.contact.email,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="theme-color" content="#07151f" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {
      [...baseStructuredData, ...pageData].map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body class="bg-[#07151f] text-[#f6f2ea] antialiased">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script>
      import { trackAnalytics } from "../lib/analytics";

      document.addEventListener("click", (event) => {
        const target = (event.target as Element | null)?.closest<HTMLElement>("[data-analytics-event]");
        const eventName = target?.dataset.analyticsEvent;
        if (eventName) trackAnalytics(eventName, { location: window.location.pathname });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  html {
    scroll-behavior: smooth;
  }
  body {
    min-width: 320px;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: "Arial Narrow", "Aptos Display", Inter, sans-serif;
  }
  :focus-visible {
    outline: 3px solid #54d7c5;
    outline-offset: 3px;
  }
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-200%);
    background: #f6f2ea;
    color: #07151f;
    padding: 0.75rem 1rem;
    font-weight: 700;
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  .map-grid {
    background-image:
      linear-gradient(rgba(84, 215, 197, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(84, 215, 197, 0.08) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
